# Environment Configuration (Optional)
# Copy this file to .env and fill in your API keys

# OpenAI API Configuration (Optional)
# If provided, the system will use GPT for enhanced responses
# If not provided, system uses built-in rule-based responses
OPENAI_API_KEY=

# LLM Model Selection (if using OpenAI)
LLM_MODEL=gpt-3.5-turbo

# DrugBank API Configuration (Not yet implemented)
# Future integration for real drug interaction data
DRUGBANK_API_KEY=
